# Copie para .env e ajuste se quiser:  cp .env.example .env
# O .env NUNCA é versionado. Todos os valores abaixo têm default no docker-compose.yml,
# então `docker compose up` também funciona sem .env (conveniente para dev local).

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=f1
POSTGRES_PASSWORD=f1_dev_password
POSTGRES_DB=f1_race_engineer

# Porta do banco NO SEU HOST (para psql/DBeaver ou para rodar a ingestão fora do Docker).
# Dentro da rede do compose o app sempre fala com db:5432. Troque se a 5432 já estiver ocupada.
POSTGRES_PORT=5432

# Host do banco quando o app roda FORA do Docker. No compose, o app usa "db" (definido lá).
POSTGRES_HOST=localhost

# --- Redis ---
# Porta do Redis NO SEU HOST (para rodar app/worker/testes fora do Docker). Dentro da rede do
# compose o app sempre fala com redis:6379. Troque se a 6379 já estiver ocupada.
REDIS_PORT=6379

# Host do Redis quando o app roda FORA do Docker. No compose, o app usa "redis" (definido lá).
REDIS_HOST=localhost

# Banco lógico do Redis (0-15). Os testes de integração usam o 15, nunca o 0.
REDIS_DB=0

# --- API ---
# Porta publicada no host.
APP_PORT=8000

# --- FastF1 ---
# Onde o FastF1 guarda o cache de downloads (fora do Docker). No compose vira um volume nomeado.
FASTF1_CACHE_DIR=.fastf1-cache
