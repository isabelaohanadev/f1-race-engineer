# Mantém o contexto de build pequeno e, principalmente, evita que segredos
# (.env) ou o cache pesado do FastF1 sejam copiados para dentro da imagem.
.git
.env
.env.*
!.env.example
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.fastf1-cache/
fastf1_cache/
cache/
.vscode/
.idea/
.DS_Store
